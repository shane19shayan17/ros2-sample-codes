<?xml version="1.0"?>

<robot name="learning_robot">

    <material name="body_color">
        <color rgba="0.0 0.0 0.80 1.0"/>
    </material>

    <material name="black">
        <color rgba="0.0 0.0 0.0 1.0"/>
    </material>

    <link name="base_link">
        <visual>
            <geometry>
                <box size="0.38 0.2 0.28"/>
            </geometry>

            <origin xyz="0.0 0.0 0.16" rpy="0.0 0.0 0.0"/>

            <material name="body_color" />
        </visual>
    </link>

    <link name="front_right_tire_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>

            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        
            <material name="black" />
        </visual>
    </link>

    <link name="front_left_tire_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>

            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        
            <material name="black" />
        </visual>
    </link>
    
    <link name="back_left_tire_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>

            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        
            <material name="black" />
        </visual>
    </link>

    <link name="back_right_tire_link">
        <visual>
            <geometry>
                <cylinder radius="0.02" length="0.03"/>
            </geometry>

            <origin xyz="0.0 0.0 0.0" rpy="0.0 1.57 1.57"/>
        
            <material name="black" />
        </visual>
    </link>

    <joint name="base_front_right_tire_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_right_tire_link"/>
        <origin xyz="0.125 -0.085 0.02" rpy="0.0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_front_left_tire_joint" type="continuous">
        <parent link="base_link"/>
        <child link="front_left_tire_link"/>
        <origin xyz="0.125 0.085 0.02" rpy="0.0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_back_left_tire_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_left_tire_link"/>
        <origin xyz="-0.125 0.085 0.02" rpy="0.0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>

    <joint name="base_back_right_tire_joint" type="continuous">
        <parent link="base_link"/>
        <child link="back_right_tire_link"/>
        <origin xyz="-0.125 -0.085 0.02" rpy="0.0 0 0"/>
        <axis xyz="0 1 0"/>
    </joint>
</robot>